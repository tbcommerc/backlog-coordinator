# DMB Backlog - Environment Variables

# Application
APP_NAME=DMB Backlog
DEBUG=true
RUN_STARTUP_SEED=false
RUN_STARTUP_MAINTENANCE=false
RUN_NOTIFICATION_SCHEDULER=true

# Local PostgreSQL and Redis from compose.yaml
DATABASE_URL=postgresql+psycopg://dmb:dmb_local_dev@127.0.0.1:5432/dmb_backlog
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
REDIS_URL=redis://127.0.0.1:6379/0
EVENT_STREAM_NAME=dmb:events
EVENT_STREAM_MAXLEN=10000
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_RETRY_INTERVAL_SECONDS=5
OUTBOX_CLAIM_TIMEOUT_SECONDS=60
OUTBOX_RETENTION_DAYS=7
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_DEAD_LETTER_RETENTION_DAYS=30
IDEMPOTENCY_RETENTION_DAYS=7

# Distributed tracing. OTLP/HTTP trace endpoint must include /v1/traces.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=dmb-backlog
OTEL_DEPLOYMENT_ENVIRONMENT=local
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_TRACE_SAMPLE_RATIO=1.0
OTEL_EXPORT_TIMEOUT_SECONDS=10
OTEL_EXCLUDED_URLS=/api/v1/health,/api/v1/health/ready,/metrics

# For multiple backend instances, mount the same persistent volume at this path.
ATTACHMENT_STORAGE_DIR=D:/dmb-shared/attachments
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=30

# Security (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-in-production-dmb2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal DMB backend -> agent authentication
AGENT_BASE_URL=http://127.0.0.1:9000
AGENT_SECRET=dmb-agent-local-secret-2026
PRIORITISER_BASE_URL=http://127.0.0.1:9100
PRIORITISER_SECRET=dmb-prioritiser-local-secret-2026
PRIORITISER_TIMEOUT_SECONDS=180

# Experimental BA/PO V2 (agents/business-analyst-experimental/)
AGENT_V2_ENABLED=false
AGENT_V2_KILL_SWITCH=false
AGENT_V2_BASE_URL=http://127.0.0.1:9300
AGENT_V2_TIMEOUT_SECONDS=180
AGENT_V2_SECRET=dmb-agent-v2-local-secret-2026
AGENT_V2_PILOT_USER_IDS=
AGENT_V2_PILOT_EMAILS=
AGENT_V2_BA_ROLE_NAMES=BA/Участник команды,BA/Бизнес-аналитик
AGENT_V2_PO_ROLE_NAMES=PO/PL/CL

# CORS
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:8080"]

# Account security (12.10.2026). Set independent random secrets outside Git.
AUTH_RATE_HMAC_KEY=
AUTH_ISSUER=dmb-backlog
AUTH_AUDIENCE=dmb-browser
AUTH_ORIGINS=["http://127.0.0.1:8000","http://localhost:8000"]
AUTH_ALLOWED_HOSTS=["127.0.0.1","localhost"]
AUTH_SUPPORT_CONTACT=Обратитесь к администратору стенда
AUTH_SESSION_HOURS=8
AUTH_IDLE_MINUTES=30
AUTH_ADMIN_IDLE_MINUTES=15
AUTH_MAX_SESSIONS=5
AUTH_INVITE_MINUTES=1440
AUTH_RECOVERY_MINUTES=30
AUTH_REAUTH_MINUTES=5
AUTH_PASSWORD_MIN=15
AUTH_PASSWORD_MAX=128
AUTH_HASH_WORKERS=4
AUTH_ARGON_MEMORY_KIB=19456
AUTH_ARGON_TIME_COST=2
AUTH_ARGON_PARALLELISM=1
AUTH_LOGIN_IP_LIMIT=120
AUTH_FAILURE_LIMIT=5
AUTH_FAILURE_WINDOW=300
AUTH_SETUP_IP_LIMIT=60
AUTH_ISSUE_TARGET_LIMIT=5
AUTH_ISSUE_ADMIN_LIMIT=30
AUTH_REFRESH_IP_LIMIT=600
AUTH_EVENTS_RETENTION_DAYS=180
AUTH_SESSION_RETENTION_DAYS=30

# Explicit compatibility only for an approved existing-account rollout.
AUTH_ALLOW_LEGACY_PASSWORDS=false

# Optional standalone backlog assistant; enable only for an approved pilot.
BACKLOG_ASSISTANT_ENABLED=false
BACKLOG_ASSISTANT_KILL_SWITCH=false
BACKLOG_ASSISTANT_PILOT_USER_IDS=
BACKLOG_ASSISTANT_SERVICE_URL=https://127.0.0.1:9400
BACKLOG_ASSISTANT_GATEWAY_SECRET=
BACKLOG_ASSISTANT_SERVICE_TOKEN=
BACKLOG_ASSISTANT_TLS_CA=
BACKLOG_ASSISTANT_TLS_CERT=
BACKLOG_ASSISTANT_TLS_KEY=

# WorkTask board pilot; false retains legacy Task kanban.
WORK_TASK_BOARD_ENABLED=false
