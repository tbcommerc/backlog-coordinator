# DMB Backlog - Environment Variables

# Application
APP_NAME=DMB Backlog
DEBUG=true
RUN_STARTUP_SEED=false
RUN_STARTUP_MAINTENANCE=false
RUN_NOTIFICATION_SCHEDULER=true

# Local PostgreSQL and Redis from compose.yaml
DATABASE_URL=postgresql+psycopg://dmb:dmb_local_dev@127.0.0.1:5432/dmb_backlog
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30
REDIS_URL=redis://127.0.0.1:6379/0
EVENT_STREAM_NAME=dmb:events
EVENT_STREAM_MAXLEN=10000
OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_SECONDS=1
OUTBOX_RETRY_INTERVAL_SECONDS=5
OUTBOX_CLAIM_TIMEOUT_SECONDS=60
OUTBOX_RETENTION_DAYS=7
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_DEAD_LETTER_RETENTION_DAYS=30
IDEMPOTENCY_RETENTION_DAYS=7

# Distributed tracing. OTLP/HTTP trace endpoint must include /v1/traces.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=dmb-backlog
OTEL_DEPLOYMENT_ENVIRONMENT=local
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_TRACE_SAMPLE_RATIO=1.0
OTEL_EXPORT_TIMEOUT_SECONDS=10
OTEL_EXCLUDED_URLS=/api/v1/health,/api/v1/health/ready,/metrics

# For multiple backend instances, mount the same persistent volume at this path.
ATTACHMENT_STORAGE_DIR=D:/dmb-shared/attachments

# Security (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-secret-key-change-in-production-dmb2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Internal DMB backend -> agent authentication
AGENT_BASE_URL=http://127.0.0.1:9000
AGENT_SECRET=dmb-agent-local-secret-2026
PRIORITISER_BASE_URL=http://127.0.0.1:9100
PRIORITISER_TIMEOUT_SECONDS=180

# CORS
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:8080"]
