# DMB Backlog - Environment Variables

# Application
APP_NAME=DMB Backlog
DEBUG=true

# Database (SQLite for local dev)
# DATABASE_URL is set in config.py with absolute path
# DATABASE_URL=sqlite:///./dmb_backlog.db

# Security (CHANGE THIS IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-this-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:8080"]