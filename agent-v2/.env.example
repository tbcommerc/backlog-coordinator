# Isolated DMB AI BA/PO Assistant V2

# The service is opt-in and starts disabled. The DMB gateway must use the same
# independent secret and derive BA/PO from the authenticated pilot profile.
AGENT_V2_ENABLED=false
AGENT_V2_KILL_SWITCH=false
AGENT_V2_PORT=9300
AGENT_V2_SECRET=dmb-agent-v2-local-secret-2026
AGENT_V2_PILOT_USER_IDS=
AGENT_V2_PILOT_EMAILS=
AGENT_V2_DEBUG=true

# V2 never shares the V1 sessions database.
AGENT_V2_SESSION_DATABASE_URL=postgresql+psycopg://agent_v2:agent_v2_local_dev@127.0.0.1:5432/agent_v2_sessions
AGENT_V2_SESSION_DB=agent_v2_sessions.db
AGENT_V2_DB_POOL_SIZE=10
AGENT_V2_DB_MAX_OVERFLOW=20
AGENT_V2_DB_POOL_TIMEOUT_SECONDS=30

# OpenAI-compatible provider. mock is suitable only for tests/health checks.
# Launcher-only: true (or empty) inherits the V1 provider, key, URL and model.
# Set false to preserve a separate OpenCode API key and model configured below.
AGENT_V2_INHERIT_V1_LLM=true
AGENT_V2_LLM_PROVIDER=openai_compat
AGENT_V2_OPENAI_API_KEY=
AGENT_V2_OPENAI_BASE_URL=https://api.openai.com/v1
AGENT_V2_OPENAI_MODEL=gpt-4o-mini
# Optional, only for models that support reasoning_effort: low | medium | high.
AGENT_V2_OPENAI_REASONING_EFFORT=
AGENT_V2_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AGENT_V2_AGENT_DECISION_MAX_TOKENS=3072
AGENT_V2_DOCUMENT_MAX_TOKENS=12000
AGENT_V2_AGENT_LLM_HISTORY_MESSAGES=40
AGENT_V2_AGENT_HISTORY_MESSAGES=100
AGENT_V2_AGENT_SLOT_HISTORY_ITEMS=20
AGENT_V2_MESSAGE_RECEIPT_RETENTION_DAYS=7

AGENT_V2_OTEL_ENABLED=false
AGENT_V2_OTEL_SERVICE_NAME=dmb-agent-v2
AGENT_V2_OTEL_DEPLOYMENT_ENVIRONMENT=local
AGENT_V2_OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
AGENT_V2_OTEL_TRACE_SAMPLE_RATIO=1.0
AGENT_V2_OTEL_EXPORT_TIMEOUT_SECONDS=10
AGENT_V2_OTEL_EXCLUDED_URLS=/api/agent-v2/health,/api/agent-v2/ready

AGENT_V2_MCP_SERVERS_JSON=
AGENT_V2_TOOLS_CONFIG_JSON=
AGENT_V2_OUT_OF_DOMAIN_MAX_STRIKES=3
AGENT_V2_KB_MAX_DOCS=4
AGENT_V2_KB_MAX_SNIPPETS=6
