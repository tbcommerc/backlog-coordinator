# Store the real file outside Git. Load the exact release image before deployment.
DMB_BACKEND_IMAGE=
# Existing database prepared by the DBA. Runtime role must not own tables or
# have CREATE/DDL privileges. URL-encode the supplied credentials.
DMB_DATABASE_URL=
DMB_REDIS_PASSWORD=
DMB_REDIS_URL=
DMB_SECRET_KEY=
DMB_AGENT_SECRET=
DMB_AUTH_RATE_HMAC_KEY=
DMB_CORS_ORIGINS=["https://dmb.example.internal"]
DMB_AUTH_ORIGINS=["https://dmb.example.internal"]
DMB_AUTH_ALLOWED_HOSTS=["dmb.example.internal","localhost","127.0.0.1","backend"]
DMB_HTTP_BIND=127.0.0.1:8080
DMB_VOLUME_PREFIX=dmb-platform
