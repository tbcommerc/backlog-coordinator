{
  "components": {
    "schemas": {
      "CreateRun": {
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "1.0",
            "title": "Contract Version"
          },
          "conversation_ref": {
            "title": "Conversation Ref",
            "type": "null"
          },
          "input": {
            "$ref": "#/components/schemas/ExtractionInput"
          },
          "operation": {
            "const": "meeting.extract",
            "title": "Operation"
          },
          "retry_of": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry Of"
          },
          "retry_of_key": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry Of Key"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          }
        },
        "required": [
          "contract_version",
          "operation",
          "source",
          "input"
        ],
        "title": "CreateRun",
        "type": "object"
      },
      "ExtractionInput": {
        "additionalProperties": false,
        "properties": {
          "meeting_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Meeting Date"
          },
          "transcript": {
            "maxLength": 60000,
            "minLength": 1,
            "title": "Transcript",
            "type": "string"
          }
        },
        "required": [
          "transcript"
        ],
        "title": "ExtractionInput",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Source": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "const": "meeting_capture",
            "title": "Kind"
          },
          "ref": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Ref",
            "type": "string"
          },
          "revision": {
            "minimum": 0.0,
            "title": "Revision",
            "type": "integer"
          },
          "snapshot_hash": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "title": "Snapshot Hash",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "ref",
          "revision",
          "snapshot_hash"
        ],
        "title": "Source",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
