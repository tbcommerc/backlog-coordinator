# Скопируйте в .env. Файл .env закоммичен быть не может (см. .gitignore).

# --- Хранилище ---------------------------------------------------------------
# Локальный/production сервис требует собственный PostgreSQL DSN.
# SQLite разрешён только изолированным unit fixtures.
PRIORITISER_DATABASE_URL=
PRIORITISER_DEBUG=false
PRIORITISER_RAG_EMBEDDING_REVISION=d13f1b27baf31030b7fd040960d60d909913633f
PRIORITISER_RAG_MODEL_CACHE_DIR=
PRIORITISER_RAG_LOCAL_FILES_ONLY=true
PRIORITISER_SERVICE_SECRET=
PRIORITISER_METHODOLOGIST_SECRET=

# --- LLM ---------------------------------------------------------------------
# В локальном сервисном профиле разрешён только Go Chat Completions.
# Остальные адаптеры доступны исключительно отдельным unit fixtures.
PRIORITISER_LLM_PROVIDER=openai_compat

# Собственный профиль: launcher не копирует ключ из V1 автоматически.
PRIORITISER_MODEL_API_KEY=
PRIORITISER_MODEL_BASE_URL=https://opencode.ai/zen/go/v1
PRIORITISER_MODEL_NAME=glm-5.3-flash
# Общий timeout одного HTTP-вызова и ограниченные retry только для временных
# ошибок сети, 429 и 502-504. Остальные ответы возвращаются сразу.
PRIORITISER_LLM_TIMEOUT_SECONDS=30
PRIORITISER_LLM_RETRY_ATTEMPTS=3
PRIORITISER_LLM_RETRY_BASE_SECONDS=0.5
PRIORITISER_LLM_RETRY_MAX_SECONDS=5
# Общий предел фоновых worker-ов для независимых оценок F5/F6.
PRIORITISER_ASSESSMENT_MAX_WORKERS=8

# anthropic. Ключ можно не задавать, если выполнен `ant auth login` —
# SDK сам подхватит профиль.
ANTHROPIC_API_KEY=
PRIORITISER_ANTHROPIC_MODEL=claude-opus-5

# gigachat (публичный контур): Authorization key из личного кабинета
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
PRIORITISER_GIGACHAT_MODEL=GigaChat-2-Max
# Корневой сертификат Минцифры; пусто = системный trust store
GIGACHAT_CA_BUNDLE=

# gigacode (внутренний контур). Значения выдаёт владелец контура,
# в репозитории их быть не должно. Схема совпадает со strategy-decomposer.
GIGACODE_ENV=
GIGACODE_LLM_BASE_URL=
GIGACODE_CA_BUNDLE=
GIGACODE_TOKEN=
GIGACODE_DEBUG=0

# --- Оценка Value --------------------------------------------------------------
# Аналогия с задачами, где Value заполнил человек. По бэктесту точнее формулы
# в пять раз, поэтому включена по умолчанию; 0 возвращает расчёт по формуле.
PRIORITISER_VALUE_ANALOGY=1
PRIORITISER_VALUE_ANALOGY_TOP_K=3

# --- Оценка факторов F6 и F7 --------------------------------------------------
# F6 «Стратегическое соответствие»:
#   stub  — только для тестов
#   agent — собственный оценщик на LLM-адаптере по рубрике
#   rest  — внешний Strategy Decomposer, как в исходном ТЗ
PRIORITISER_STRATEGY_PROVIDER=agent

# F7 «Зависимость от команд»:
#   declared — из атрибута бэклога «Другие вовлечённые команды» (дефолт)
#   agent    — собственный оценщик, определяет тип каждой связи
PRIORITISER_DEPENDENCY_PROVIDER=declared

# Подмешивать материалы корпуса в промпт оценщика.
PRIORITISER_STRATEGY_USE_RAG=1

# Нужны только при PRIORITISER_STRATEGY_PROVIDER=rest.
STRATEGY_DECOMPOSER_URL=
STRATEGY_DECOMPOSER_TOKEN=

# --- RAG ---------------------------------------------------------------------
# Плотный (векторный) слой поиска. 1 = BM25 + FAISS с объединением через RRF,
# 0 = только BM25. Модель должна совпадать с той, на которой собран пакет K3.
PRIORITISER_RAG_VECTOR=1
PRIORITISER_RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Индексировать корпус K3, если пакет установлен. Поставьте 0 для демонстраций
# и внешних показов, где материалы этой классификации показывать нельзя.
PRIORITISER_RAG_ALLOW_K3=1

# Путь к локальному клону strategy-decomposer. Нужен, только если шифротекст
# пакета не лежит в data/rag-package/ (например, вытянут через Git LFS отдельно).
SD_REPO_ROOT=

# Explicit isolated tests only; never enable for local/production service.
PRIORITISER_UNIT_TEST_MODE=false

# OpenCode runtime tools: cli (operator compatibility) or http (scoped tools).
# Configure token/run only in the isolated per-run runtime, not in this file.
PRIORITISER_TOOL_MODE=cli
PRIORITISER_TOOL_BASE_URL=

# Optional own RAG index volume, separate from immutable corpus and model cache.
PRIORITISER_RAG_INDEX_DIR=
