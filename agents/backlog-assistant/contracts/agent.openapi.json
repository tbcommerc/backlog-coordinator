  "components": {
    "schemas": {
      "Context": {
        "properties": {
          "surface": {
            "type": "string",
            "enum": [
              "backlog",
              "task",
              "request",
              "report",
              "assistant"
            ],
            "title": "Surface",
            "default": "assistant"
          },
          "object_ref": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Object Ref"
          },
          "filters": {
            "$ref": "#/components/schemas/QuerySpec"
          },
          "timezone": {
            "const": "Europe/Moscow",
            "title": "Timezone",
            "default": "Europe/Moscow"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Context"
      },
      "Feedback": {
        "properties": {
          "rating": {
            "type": "integer",
            "enum": [
              -1,
              1
            ],
            "title": "Rating"
          },
          "reason_code": {
            "type": "string",
            "enum": [
              "incorrect",
              "incomplete",
              "irrelevant",
              "helpful",
              "other"
            ],
            "title": "Reason Code"
          },
          "comment": {
            "type": "string",
            "maxLength": 1000,
            "title": "Comment",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "rating",
          "reason_code"
        ],
        "title": "Feedback"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MessageCreate": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Text"
          },
          "context_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Context Revision"
          },
          "context": {
            "$ref": "#/components/schemas/Context"
          },
          "execution_ref": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Execution Ref"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "context_revision",
          "context",
          "execution_ref"
        ],
        "title": "MessageCreate"
      },
      "QuerySpec": {
        "properties": {
          "object_type": {
            "type": "string",
            "enum": [
              "task",
              "request"
            ],
            "title": "Object Type",
            "default": "task"
          },
          "team_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Team Ids"
          },
          "project_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Project Ids"
          },
          "status_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Status Ids"
          },
          "priority_ids": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Priority Ids"
          },
          "relationship": {
            "type": "string",
            "enum": [
              "all",
              "mine",
              "my_team"
            ],
            "title": "Relationship",
            "default": "all"
          },
          "period": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ],
            "title": "Period"
          },
          "created_from": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created From"
          },
          "created_to": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created To"
          },
          "updated_from": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated From"
          },
          "updated_to": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated To"
          },
          "missing": {
            "items": {
              "type": "string",
              "enum": [
                "owner",
                "effort",
                "effect",
                "period"
              ]
            },
            "type": "array",
            "title": "Missing"
          },
          "terms": {
            "items": {
              "type": "string",
              "maxLength": 200,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 8,
            "title": "Terms"
          },
          "sort": {
            "type": "string",
            "enum": [
              "id",
              "updated_desc"
            ],
            "title": "Sort",
            "default": "id"
          },
          "cursor": {
            "type": "integer",
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Cursor",
            "default": 0
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "QuerySpec"
      },
      "SessionCreate": {
        "properties": {
          "context": {
            "$ref": "#/components/schemas/Context"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SessionCreate"
      },
      "SessionPatch": {
        "properties": {
          "context_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Context Revision"
          },
          "archived": {
            "type": "boolean",
            "title": "Archived",
            "default": false
          },
          "context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Context"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "context_revision"
        ],
        "title": "SessionPatch"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
