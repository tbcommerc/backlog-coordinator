{
  "components": {
    "schemas": {
      "Context": {
        "additionalProperties": false,
        "properties": {
          "filters": {
            "$ref": "#/components/schemas/QuerySpec"
          },
          "object_ref": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Object Ref"
          },
          "surface": {
            "default": "assistant",
            "enum": [
              "backlog",
              "task",
              "request",
              "report",
              "assistant"
            ],
            "title": "Surface",
            "type": "string"
          },
          "timezone": {
            "const": "Europe/Moscow",
            "default": "Europe/Moscow",
            "title": "Timezone"
          }
        },
        "title": "Context",
        "type": "object"
      },
      "CreateRun": {
        "additionalProperties": false,
        "properties": {
          "contract_version": {
            "const": "1.0",
            "title": "Contract Version"
          },
          "conversation_ref": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Conversation Ref"
          },
          "input": {
            "title": "Input",
            "type": "object"
          },
          "operation": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Operation",
            "type": "string"
          },
          "retry_of": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry Of"
          },
          "retry_of_key": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry Of Key"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          }
        },
        "required": [
          "contract_version",
          "operation",
          "source",
          "input"
        ],
        "title": "CreateRun",
        "type": "object"
      },
      "Feedback": {
        "additionalProperties": false,
        "properties": {
          "comment": {
            "default": "",
            "maxLength": 1000,
            "title": "Comment",
            "type": "string"
          },
          "rating": {
            "enum": [
              -1,
              1
            ],
            "title": "Rating",
            "type": "integer"
          },
          "reason_code": {
            "enum": [
              "incorrect",
              "incomplete",
              "irrelevant",
              "helpful",
              "other"
            ],
            "title": "Reason Code",
            "type": "string"
          }
        },
        "required": [
          "rating",
          "reason_code"
        ],
        "title": "Feedback",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MessageCreate": {
        "additionalProperties": false,
        "properties": {
          "context": {
            "$ref": "#/components/schemas/Context"
          },
          "context_revision": {
            "minimum": 1.0,
            "title": "Context Revision",
            "type": "integer"
          },
          "execution_ref": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Execution Ref",
            "type": "string"
          },
          "text": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "text",
          "context_revision",
          "context",
          "execution_ref"
        ],
        "title": "MessageCreate",
        "type": "object"
      },
      "QuerySpec": {
        "additionalProperties": false,
        "properties": {
          "created_from": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created From"
          },
          "created_to": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created To"
          },
          "cursor": {
            "default": 0,
            "maximum": 1000000.0,
            "minimum": 0.0,
            "title": "Cursor",
            "type": "integer"
          },
          "missing": {
            "items": {
              "enum": [
                "owner",
                "effort",
                "effect",
                "period"
              ],
              "type": "string"
            },
            "title": "Missing",
            "type": "array"
          },
          "object_type": {
            "default": "task",
            "enum": [
              "task",
              "request"
            ],
            "title": "Object Type",
            "type": "string"
          },
          "period": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Period"
          },
          "priority_ids": {
            "items": {
              "type": "integer"
            },
            "maxItems": 100,
            "title": "Priority Ids",
            "type": "array"
          },
          "project_ids": {
            "items": {
              "type": "integer"
            },
            "maxItems": 100,
            "title": "Project Ids",
            "type": "array"
          },
          "relationship": {
            "default": "all",
            "enum": [
              "all",
              "mine",
              "my_team"
            ],
            "title": "Relationship",
            "type": "string"
          },
          "sort": {
            "default": "id",
            "enum": [
              "id",
              "updated_desc"
            ],
            "title": "Sort",
            "type": "string"
          },
          "status_ids": {
            "items": {
              "type": "integer"
            },
            "maxItems": 100,
            "title": "Status Ids",
            "type": "array"
          },
          "team_ids": {
            "items": {
              "type": "integer"
            },
            "maxItems": 100,
            "title": "Team Ids",
            "type": "array"
          },
          "terms": {
            "items": {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            "maxItems": 8,
            "title": "Terms",
            "type": "array"
          },
          "updated_from": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated From"
          },
          "updated_to": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated To"
          }
        },
        "title": "QuerySpec",
        "type": "object"
      },
      "SessionCreate": {
        "additionalProperties": false,
        "properties": {
          "context": {
            "$ref": "#/components/schemas/Context"
          }
        },
        "title": "SessionCreate",
        "type": "object"
      },
      "SessionPatch": {
        "additionalProperties": false,
        "properties": {
          "archived": {
            "default": false,
            "title": "Archived",
            "type": "boolean"
          },
          "context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Context"
              },
              {
                "type": "null"
              }
            ]
          },
          "context_revision": {
            "minimum": 1.0,
            "title": "Context Revision",
            "type": "integer"
          }
        },
        "required": [
          "context_revision"
        ],
        "title": "SessionPatch",
        "type": "object"
      },
      "Source": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Kind",
            "type": "string"
          },
          "ref": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Ref",
            "type": "string"
          },
          "revision": {
            "minimum": 0.0,
            "title": "Revision",
            "type": "integer"
          },
          "snapshot_hash": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "title": "Snapshot Hash",
            "type": "string"
          }
        },
        "required": [
          "kind",
          "ref",
          "revision",
          "snapshot_hash"
        ],
        "title": "Source",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
