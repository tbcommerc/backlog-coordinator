    {
      "name": "read_task",
      "description": "read_task",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "Exact internal reference task:N including the prefix. Public IDs must be searched first.",
