    {
      "name": "compare_tasks",
      "description": "compare_tasks",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_refs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 10,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^task:[1-9][0-9]*$",
              "description": "Internal task:N reference."
            }
          },
          "dimensions": {
            "type": "array",
            "items": {
              "enum": [
                "status",
                "priority",
                "cost_rub",
                "effect_million_rub",
                "cost_value"
              ]
            },
            "maxItems": 5,
            "description": "Requested comparison fields. Cost/Value = cost_value (server-calculated ratio); cost_rub is cost only, not the ratio."
          }
        },
        "required": [
          "task_refs",
          "dimensions"
        ]
      }
