# Dedicated PostgreSQL database; never the DMB database URL.
ASSISTANT_DATABASE_URL=postgresql+psycopg://assistant:replace@127.0.0.1:5432/backlog_assistant
ASSISTANT_GATEWAY_SECRET=
ASSISTANT_RUNTIME=opencode
ASSISTANT_SYNTHETIC_ONLY=false
ASSISTANT_RUNTIME_IMAGE=
ASSISTANT_STATE_DIR=.runtime/instances
# Trusted controller container: set both only after explicit Docker access setup.
# The IP is verified against the controller's actual network attachment.
ASSISTANT_DOCKER_NETWORK=
ASSISTANT_DOCKER_BRIDGE_IP=
ASSISTANT_MODEL_URL=https://opencode.ai/zen/go/v1
ASSISTANT_MODEL=glm-5.3-flash
ASSISTANT_MODEL_KEY=
DMB_DATA_API_URL=https://127.0.0.1:9450/internal/backlog-assistant/v1
ASSISTANT_SERVICE_TOKEN=
ASSISTANT_TLS_CA=
ASSISTANT_TLS_CERT=
ASSISTANT_TLS_KEY=
