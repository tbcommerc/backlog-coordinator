# DMB AI Business Analyst Assistant - Environment Variables

# LLM provider for the running application. Mock is test-only.
AGENT_LLM_PROVIDER=openai_compat

# OpenAI-compatible endpoint (OpenAI, Azure OpenAI, vLLM, Ollama, LM Studio...)
AGENT_MODEL_API_KEY=
AGENT_MODEL_BASE_URL=https://opencode.ai/zen/go/v1
AGENT_MODEL_NAME=glm-5.3-flash
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Maximum completion budget for one structured dialogue decision.
# Keep bounded to avoid reserving excessive provider quota per request.
AGENT_DECISION_MAX_TOKENS=3072

# Service
AGENT_PORT=9000
DEBUG=true
# Primary local store. SESSION_DB remains as a SQLite fallback for isolated tests.
AGENT_DATABASE_URL=postgresql+psycopg://dmb:dmb_local_dev@127.0.0.1:5432/agent_sessions
SESSION_DB=agent_sessions.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_SECONDS=30

# Internal auth between DMB backend and agent (header X-Agent-Secret)
AGENT_SERVICE_SECRET=

# Distributed tracing. OTLP/HTTP trace endpoint must include /v1/traces.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=dmb-agent
OTEL_DEPLOYMENT_ENVIRONMENT=local
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:4318/v1/traces
OTEL_TRACE_SAMPLE_RATIO=1.0
OTEL_EXPORT_TIMEOUT_SECONDS=10
OTEL_EXCLUDED_URLS=/api/agent/health

# MCP servers: JSON list of {"name", "command", "args"}
# MCP_SERVERS_JSON=[{"name":"kb-tools","command":"python","args":["server.py"]}]
MCP_SERVERS_JSON=

# External tools: JSON list of {"name", "description", "mock_response"}
# TOOLS_CONFIG_JSON=[{"name":"product_catalog","description":"Каталог продуктов","mock_response":"{}"}]
TOOLS_CONFIG_JSON=

# Dialogue and retrieval limits
OUT_OF_DOMAIN_MAX_STRIKES=3
KB_MAX_DOCS=4
KB_MAX_SNIPPETS=6

# Unit fixtures only; never enable for a running application.
AGENT_UNIT_TEST_MODE=false

# Go chat does not provide an embeddings capability.
AGENT_EMBEDDINGS_ENABLED=false
