# Copy outside the repository or pass with `docker compose --env-file`.
# Secret values are deliberately empty and must come from the stand secret store.
DMB_POSTGRES_PASSWORD=
DMB_REDIS_PASSWORD=
# The credentials inside URLs must be percent-encoded. Keep both URLs aligned
# with the raw service passwords above.
DMB_DATABASE_URL=
DMB_AGENT_SESSION_DATABASE_URL=
DMB_REDIS_URL=
DMB_SECRET_KEY=
DMB_AGENT_SECRET=
DMB_CORS_ORIGINS=["https://dmb.example.internal"]

DMB_ENVIRONMENT=production
DMB_HTTP_BIND=127.0.0.1:8080
DMB_VOLUME_PREFIX=dmb-platform
DMB_OTEL_SAMPLE_RATIO=0.2

# A real provider must be configured before user acceptance testing.
DMB_LLM_PROVIDER=openai_compat
DMB_OPENAI_API_KEY=
DMB_OPENAI_BASE_URL=https://api.openai.com/v1
DMB_OPENAI_MODEL=gpt-4o-mini
